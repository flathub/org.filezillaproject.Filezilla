{
  "id": "org.filezillaproject.Filezilla",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "filezilla",
  "rename-icon": "filezilla",
  "copy-icon": true,
  "rename-desktop-file": "filezilla.desktop",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--talk-name=org.freedesktop.PowerManagement",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.gnome.SessionManager",
    "--filesystem=host",
    "--share=network",
    "--socket=ssh-auth"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/lib/*.a",
    "/lib/*.la",
    "/share/aclocal"
  ],
  "modules": [
    "shared-modules/glu/glu-9.json",
    {
      "name": "boost",
      "sources": [
        {
          "x-checker-data": {
            "type": "anitya",
            "project-id": 6845,
            "url-template": "https://archives.boost.io/release/$version/source/boost_${major}_${minor}_${patch}.tar.bz2"
          },
          "type": "archive",
          "url": "https://archives.boost.io/release/1.92.0/source/boost_1_92_0.tar.bz2",
          "sha256": "5c1d40cb8e19adbf740a4ec2da35b3e58f3f5804b1dce44deb53df72193cbc6c"
        }
      ],
      "buildsystem": "simple",
      "build-commands": [
        "./bootstrap.sh",
        "./b2 install --prefix=/app/ variant=release link=static threading=multi --with-regex -j $FLATPAK_BUILDER_N_JOBS"
      ],
      "cleanup": [
        "/lib/",
        ""
      ]
    },
    {
      "name": "wxWidgets",
      "cleanup": [
        "/bin",
        "/share/bakefile"
      ],
      "config-opts": [
        "--without-opengl",
        "--with-libjpeg",
        "--with-libtiff",
        "--with-libpng",
        "--with-zlib",
        "--disable-sdltest",
        "--enable-unicode",
        "--enable-display",
        "--enable-propgrid",
        "--disable-webview",
        "--disable-webviewwebkit",
        "--with-expat=builtin",
        "--with-libiconv=/usr"
      ],
      "build-options": {
        "cxxflags": "-std=c++0x"
      },
      "sources": [
        {
          "x-checker-data": {
            "type": "anitya",
            "project-id": 5150,
            "stable-only": true,
            "url-template": "https://github.com/wxWidgets/wxWidgets/releases/download/v$version/wxWidgets-$version.tar.bz2"
          },
          "type": "archive",
          "url": "https://github.com/wxWidgets/wxWidgets/releases/download/v3.2.12/wxWidgets-3.2.12.tar.bz2",
          "sha256": "a62719bb5e1dcc41c1a6fc1eecd499c7ee8521f70402c7b1bb3342a1e16344e0"
        }
      ]
    },
    {
      "name": "libfilezilla",
      "sources": [
        {
          "x-checker-data": {
            "type": "html",
            "//": "filezilla-project.org blocks fedc user agent",
            "url": "https://sources.archlinux.org/other/packages/libfilezilla/",
            "pattern": "(libfilezilla-([0-9.]+)\\.tar\\.xz)",
            "is-important": true
          },
          "type": "archive",
          "url": "https://sources.archlinux.org/other/packages/libfilezilla/libfilezilla-0.59.0.tar.xz",
          "sha512": "9c54d00bd84feb77f300ee7d0e7f3dea60c73b86bb119ab48494994374eebcc0f10f462bf5a2290c7d201c90ece5c95a51f255ed4c772c40420e2caeb0a74ff2"
        }
      ]
    },
    {
      "name": "argon2",
      "no-autogen": true,
      "make-args": [
        "OPTTARGET=none"
      ],
      "make-install-args": [
        "OPTTARGET=none",
        "PREFIX=/app",
        "LIBRARY_REL=lib"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/P-H-C/phc-winner-argon2/archive/refs/tags/20190702.tar.gz",
          "sha256": "daf972a89577f8772602bf2eb38b6a3dd3d922bf5724d45e7f9589b5e830442c"
        }
      ]
    },
    {
      "name": "fzssh",
      "buildsystem": "meson",
      "sources": [
        {
          "x-checker-data": {
            "type": "html",
            "url": "https://sources.archlinux.org/other/packages/fzssh/",
            "pattern": "(fzssh-([0-9.]+)\\.tar\\.xz)",
            "is-important": true
          },
          "type": "archive",
          "url": "https://sources.archlinux.org/other/packages/fzssh/fzssh-1.5.2.tar.xz",
          "sha512": "efeb98387c28377dba6685acf01c1f6b47401414f9748c0135b8ab09d566b800b100a32971a9daa66480a3598549dd9ae1c5d2046e84b1199d0c906554826d31"
        }
      ]
    },
    {
      "name": "filezilla",
      "config-opts": [
        "--disable-autoupdatecheck",
        "--disable-manualupdatecheck",
        "--with-pugixml=builtin"
      ],
      "cleanup": [
        "/share/pixmaps",
        "/share/man"
      ],
      "post-install": [
        "install -Dm644 org.filezillaproject.Filezilla.metainfo.xml ${FLATPAK_DEST}/share/metainfo/org.filezillaproject.Filezilla.metainfo.xml",
        "rm /app/share/appdata/filezilla.appdata.xml"
      ],
      "sources": [
        {
          "x-checker-data": {
            "type": "html",
            "//": "filezilla-project.org blocks fedc user agent",
            "url": "https://sources.archlinux.org/other/filezilla/",
            "pattern": "(filezilla-([0-9.]+)\\.tar\\.xz)",
            "is-main-source": true
          },
          "type": "archive",
          "url": "https://sources.archlinux.org/other/filezilla/filezilla-3.72.1.tar.xz",
          "sha512": "4cac3c7665da76bbe44a69c9b0d9b23b21cd0e4f111de3b7ae4dbae69693c24ed6904b42e23cf9b0898c068a7b0ae75f4a82b755093c05fede9296302e88af20"
        },
        {
          "type": "file",
          "path": "org.filezillaproject.Filezilla.metainfo.xml"
        },
        {
          "type": "patch",
          "path": "0001-Correct-notification-icon-and-app-name.patch"
        },
        {
          "type": "patch",
          "path": "desktop-file-mime.patch"
        }
      ]
    }
  ]
}
