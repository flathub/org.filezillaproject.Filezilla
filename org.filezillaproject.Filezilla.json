{
  "id": "org.filezillaproject.Filezilla",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "filezilla",
  "rename-icon": "filezilla",
  "copy-icon": true,
  "rename-desktop-file": "filezilla.desktop",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--talk-name=org.freedesktop.PowerManagement",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.gnome.SessionManager",
    "--filesystem=host",
    "--share=network",
    "--socket=ssh-auth"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/lib/*.a",
    "/lib/*.la",
    "/share/aclocal"
  ],
  "modules": [
    "shared-modules/glu/glu-9.json",
    {
      "name": "boost",
      "sources": [
        {
          "x-checker-data": {
            "type": "anitya",
            "project-id": 6845,
            "url-template": "https://archives.boost.io/release/$version/source/boost_${major}_${minor}_${patch}.tar.bz2"
          },
          "type": "archive",
          "url": "https://archives.boost.io/release/1.92.0/source/boost_1_92_0.tar.bz2",
          "sha256": "5c1d40cb8e19adbf740a4ec2da35b3e58f3f5804b1dce44deb53df72193cbc6c"
        }
      ],
      "buildsystem": "simple",
      "build-commands": [
        "./bootstrap.sh",
        "./b2 install --prefix=/app/ variant=release link=static threading=multi --with-regex -j $FLATPAK_BUILDER_N_JOBS"
      ],
      "cleanup": [
        "/lib/",
        ""
      ]
    },
    {
      "name": "wxWidgets",
      "cleanup": [
        "/bin",
        "/share/bakefile"
      ],
      "config-opts": [
        "--without-opengl",
        "--with-libjpeg",
        "--with-libtiff",
        "--with-libpng",
        "--with-zlib",
        "--disable-sdltest",
        "--enable-unicode",
        "--enable-display",
        "--enable-propgrid",
        "--disable-webview",
        "--disable-webviewwebkit",
        "--with-expat=builtin",
        "--with-libiconv=/usr"
      ],
      "build-options": {
        "cxxflags": "-std=c++0x"
      },
      "sources": [
        {
          "x-checker-data": {
            "type": "anitya",
            "project-id": 5150,
            "stable-only": true,
            "url-template": "https://github.com/wxWidgets/wxWidgets/releases/download/v$version/wxWidgets-$version.tar.bz2"
          },
          "type": "archive",
          "url": "https://github.com/wxWidgets/wxWidgets/releases/download/v3.2.12/wxWidgets-3.2.12.tar.bz2",
          "sha256": "a62719bb5e1dcc41c1a6fc1eecd499c7ee8521f70402c7b1bb3342a1e16344e0"
        }
      ]
    },
    {
      "name": "libfilezilla",
      "sources": [
        {
          "x-checker-data": {
            "type": "html",
            "//": "filezilla-project.org blocks fedc user agent",
            "url": "https://sources.archlinux.org/other/packages/libfilezilla/",
            "pattern": "(libfilezilla-([0-9.]+)\\.tar\\.xz)",
            "is-important": true
          },
          "type": "archive",
          "url": "https://sources.archlinux.org/other/packages/libfilezilla/libfilezilla-0.58.0.tar.xz",
          "sha512": "8bcfe47e4c704e0fd4ed66da47e834b031ed4f6dd66a7e4f7991a7e87f3c88f38b822d58de83c0f4f84118b87c9a8ff1ac00913a40fb692718c49ad8063bd83a"
        }
      ]
    },
    {
      "name": "argon2",
      "no-autogen": true,
      "make-args": [
        "OPTTARGET=none"
      ],
      "make-install-args": [
        "OPTTARGET=none",
        "PREFIX=/app",
        "LIBRARY_REL=lib"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/P-H-C/phc-winner-argon2/archive/refs/tags/20190702.tar.gz",
          "sha256": "daf972a89577f8772602bf2eb38b6a3dd3d922bf5724d45e7f9589b5e830442c"
        }
      ]
    },
    {
      "name": "fzssh",
      "buildsystem": "meson",
      "sources": [
        {
          "x-checker-data": {
            "type": "html",
            "url": "https://sources.archlinux.org/other/packages/fzssh/",
            "pattern": "(fzssh-([0-9.]+)\\.tar\\.xz)",
            "is-important": true
          },
          "type": "archive",
          "url": "https://sources.archlinux.org/other/packages/fzssh/fzssh-1.5.0.tar.xz",
          "sha512": "2b9e4529029f6cee65c2939205440f2be9ac30c984a5ceeeefdb5e4ef8666d4590a2d658224c79a2ee046af49800a2fd0a3c6725efe2e8d4739d725b8bbdb690"
        }
      ]
    },
    {
      "name": "filezilla",
      "config-opts": [
        "--disable-autoupdatecheck",
        "--disable-manualupdatecheck",
        "--with-pugixml=builtin"
      ],
      "cleanup": [
        "/share/pixmaps",
        "/share/man"
      ],
      "post-install": [
        "install -Dm644 org.filezillaproject.Filezilla.metainfo.xml ${FLATPAK_DEST}/share/metainfo/org.filezillaproject.Filezilla.metainfo.xml",
        "rm /app/share/appdata/filezilla.appdata.xml"
      ],
      "sources": [
        {
          "x-checker-data": {
            "type": "html",
            "//": "filezilla-project.org blocks fedc user agent",
            "url": "https://sources.archlinux.org/other/filezilla/",
            "pattern": "(filezilla-([0-9.]+)\\.tar\\.xz)",
            "is-main-source": true
          },
          "type": "archive",
          "url": "https://sources.archlinux.org/other/filezilla/filezilla-3.71.1.tar.xz",
          "sha512": "44c9c9db88053a1b01ee27ebc9968eabff57d2ba6b23ac44ab080e3def9d5206cb4391dd7e0742bbd6189657a48525cfd5347d34ae87b69ccbd78b29e0101fda"
        },
        {
          "type": "file",
          "path": "org.filezillaproject.Filezilla.metainfo.xml"
        },
        {
          "type": "patch",
          "path": "0001-Correct-notification-icon-and-app-name.patch"
        },
        {
          "type": "patch",
          "path": "desktop-file-mime.patch"
        }
      ]
    }
  ]
}
