{
  "id": "org.filezillaproject.Filezilla",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "filezilla",
  "rename-icon": "filezilla",
  "copy-icon": true,
  "rename-desktop-file": "filezilla.desktop",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--talk-name=org.freedesktop.PowerManagement",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.gnome.SessionManager",
    "--filesystem=host",
    "--share=network",
    "--socket=ssh-auth"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/lib/*.a",
    "/lib/*.la",
    "/share/aclocal"
  ],
  "modules": [
    "shared-modules/glu/glu-9.json",
    {
      "name": "boost",
      "sources": [
        {
          "x-checker-data": {
            "type": "anitya",
            "project-id": 6845,
            "url-template": "https://archives.boost.io/release/$version/source/boost_${major}_${minor}_${patch}.tar.bz2"
          },
          "type": "archive",
          "url": "https://archives.boost.io/release/1.92.0/source/boost_1_92_0.tar.bz2",
          "sha256": "5c1d40cb8e19adbf740a4ec2da35b3e58f3f5804b1dce44deb53df72193cbc6c"
        }
      ],
      "buildsystem": "simple",
      "build-commands": [
        "./bootstrap.sh",
        "./b2 install --prefix=/app/ variant=release link=static threading=multi --with-regex -j $FLATPAK_BUILDER_N_JOBS"
      ],
      "cleanup": [
        "/lib/",
        ""
      ]
    },
    {
      "name": "wxWidgets",
      "cleanup": [
        "/bin",
        "/share/bakefile"
      ],
      "config-opts": [
        "--without-opengl",
        "--with-libjpeg",
        "--with-libtiff",
        "--with-libpng",
        "--with-zlib",
        "--disable-sdltest",
        "--enable-unicode",
        "--enable-display",
        "--enable-propgrid",
        "--disable-webview",
        "--disable-webviewwebkit",
        "--with-expat=builtin",
        "--with-libiconv=/usr"
      ],
      "build-options": {
        "cxxflags": "-std=c++0x"
      },
      "sources": [
        {
          "x-checker-data": {
            "type": "anitya",
            "project-id": 5150,
            "stable-only": true,
            "url-template": "https://github.com/wxWidgets/wxWidgets/releases/download/v$version/wxWidgets-$version.tar.bz2"
          },
          "type": "archive",
          "url": "https://github.com/wxWidgets/wxWidgets/releases/download/v3.2.11/wxWidgets-3.2.11.tar.bz2",
          "sha256": "6a129015bce2e914e4bf61ec4411854ad962801d47e92f2eb8340adb6a90af08"
        }
      ]
    },
    {
      "name": "libfilezilla",
      "sources": [
        {
          "x-checker-data": {
            "type": "html",
            "//": "filezilla-project.org blocks fedc user agent",
            "url": "https://sources.archlinux.org/other/packages/libfilezilla/",
            "pattern": "(libfilezilla-([0-9.]+)\\.tar\\.xz)",
            "is-important": true
          },
          "type": "archive",
          "url": "https://sources.archlinux.org/other/packages/libfilezilla/libfilezilla-0.56.1.tar.xz",
          "sha512": "b488968ea8d0f8b4b83f45755303bf94a0118cded5fe911a187c532962e2445c2e2851311229cddcec3141d9e0d0a84076927812cd9a78b83ca0693dcc23fbfd"
        }
      ]
    },
    {
      "name": "argon2",
      "no-autogen": true,
      "make-install-args": [
        "PREFIX=/app",
        "LIBRARY_REL=lib"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/P-H-C/phc-winner-argon2/archive/refs/tags/20190702.tar.gz",
          "sha256": "daf972a89577f8772602bf2eb38b6a3dd3d922bf5724d45e7f9589b5e830442c"
        }
      ]
    },
    {
      "name": "fzssh",
      "buildsystem": "meson",
      "sources": [
        {
          "x-checker-data": {
            "type": "html",
            "url": "https://sources.archlinux.org/other/packages/fzssh/",
            "pattern": "(fzssh-([0-9.]+)\\.tar\\.xz)",
            "is-important": true
          },
          "type": "archive",
          "url": "https://sources.archlinux.org/other/packages/fzssh/fzssh-1.3.0.tar.xz",
          "sha512": "6ebe301df01b24a4d3692053e65c9e4c1b510b197d7da1f353df60e3ba3dff935d68007f21d5403ba3686133b39305758afc89c0a734cfddc8f549b714bdfb22"
        }
      ]
    },
    {
      "name": "filezilla",
      "config-opts": [
        "--disable-autoupdatecheck",
        "--disable-manualupdatecheck",
        "--with-pugixml=builtin"
      ],
      "cleanup": [
        "/share/pixmaps",
        "/share/man"
      ],
      "post-install": [
        "install -Dm644 org.filezillaproject.Filezilla.metainfo.xml ${FLATPAK_DEST}/share/metainfo/org.filezillaproject.Filezilla.metainfo.xml",
        "rm /app/share/appdata/filezilla.appdata.xml"
      ],
      "sources": [
        {
          "x-checker-data": {
            "type": "html",
            "//": "filezilla-project.org blocks fedc user agent",
            "url": "https://sources.archlinux.org/other/filezilla/",
            "pattern": "(filezilla-([0-9.]+)\\.tar\\.xz)",
            "is-main-source": true
          },
          "type": "archive",
          "url": "https://sources.archlinux.org/other/filezilla/filezilla-3.70.6.tar.xz",
          "sha512": "22c8315adc4ba43868c2b0d4fdfc49ff063e3fd4817907cc5f53aa3837158ca58fd516280db406699daed5b07f16d52bc47f7034f6c32252063bec4316f8a154"
        },
        {
          "type": "file",
          "path": "org.filezillaproject.Filezilla.metainfo.xml"
        },
        {
          "type": "patch",
          "path": "0001-Correct-notification-icon-and-app-name.patch"
        },
        {
          "type": "patch",
          "path": "desktop-file-mime.patch"
        }
      ]
    }
  ]
}
